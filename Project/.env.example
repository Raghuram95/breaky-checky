# Copy this file to .env and fill in your own values. Never commit the real .env file.
# Your Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# The Gemini model every agent and the chat use, for example a Flash-Lite model
GEMINI_MODEL=your-gemini-model-name-here
