# ---- Secrets: never commit the real key (use .env.example as the template) ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Generated by the pipeline (rebuild with the run_*.py entry points) ----
processed/
output/
database/

# ---- Tests and tools ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Hugging Face / sentence-transformers model cache, if pointed at the project ----
.cache/

# ---- Editors and operating systems ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
